{
  "version": "brigade-memory-scan.v5",
  "injections": [
    {
      "id": "classic-injection",
      "pattern": "(?i)(ignore (all )?(previous|prior) instructions|do not (tell|reveal)|hidden instruction|send (all )?(secrets|tokens)|exfiltrat|disable safety|bypass safety)",
      "flags": 42,
      "action": "warn"
    },
    {
      "id": "disregard-system-prompt",
      "pattern": "(?i)disregard (your |the )?system prompt",
      "flags": 42,
      "action": "warn"
    },
    {
      "id": "ignore-instructions",
      "pattern": "(?i)ignore (all |any )?(previous|prior|above) (instructions|directives)",
      "flags": 42,
      "action": "warn"
    },
    {
      "id": "fake-system-block",
      "pattern": "(?i)(<\\s{0,256}/?\\s{0,256}system\\b|\\[INST\\]|\\[/INST\\]|<<\\s{0,256}SYS\\s{0,256}>>)",
      "flags": 42,
      "action": "warn"
    },
    {
      "id": "role-override",
      "pattern": "(?i)\\byou are now\\b",
      "flags": 42,
      "action": "warn"
    },
    {
      "id": "assistant-directive",
      "pattern": "(?i)(?:^(?:assistant|agent|ai)\\s{0,256}[,:-]\\s{0,256}(?:you )?(?:must|should|need to)\\b|(?:dear|hey) (?:assistant|agent|ai)\\b.{0,256}\\b(?:ignore|disregard|override)\\b)",
      "flags": 42,
      "action": "warn"
    },
    {
      "id": "role-override",
      "pattern": "(?i)\\bnew system prompt\\b",
      "flags": 0,
      "action": "warn"
    },
    {
      "id": "base64-decode-chain",
      "pattern": "^(?=[^\\n]{0,256}[A-Za-z0-9+/]{80,4096}={0,2})(?=[^\\n]{0,4096}(?:\\n[^\\n]{0,4096}){0,3}\\b(?i:base64|atob|decode|decrypt)\\b)[^\\n]{1,4096}",
      "flags": 8,
      "action": "warn"
    }
  ],
  "rules": [
    {
      "id": "coauthored-by-trailer",
      "pattern": "^Co-authored-by:\\s*.+(?:\\r?\\n)?",
      "flags": 10,
      "action": "block"
    },
    {
      "id": "example-phone-555",
      "pattern": "(?:(?<!\\w)\\+1[\\s.-]?\\(?555\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}(?!\\w)|(?<!\\w)\\(555\\)\\s{0,256}\\d{3}[\\s.-]?\\d{4}(?!\\w)|(?<!\\w)555[\\s.-]\\d{3}[\\s.-]\\d{4}(?!\\w))",
      "flags": 2,
      "action": "warn"
    },
    {
      "id": "example-email-reserved",
      "pattern": "\\b[A-Z0-9._%+-]{1,256}@(?:(?:[A-Z0-9-]{1,63}\\.){0,127}example\\.(?:com|org|net)|(?:[A-Z0-9-]{1,63}\\.){0,127}(?:test|invalid|localhost|local))\\b",
      "flags": 2,
      "action": "warn"
    },
    {
      "id": "ssh-private-target",
      "pattern": "\\b[\\w.-]{1,256}@(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|127\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3})(?::\\S{1,4096})?",
      "flags": 0,
      "action": "block"
    },
    {
      "id": "private-ipv4",
      "pattern": "\\b(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3})\\b",
      "flags": 0,
      "action": "block"
    },
    {
      "id": "loopback-ipv4",
      "pattern": "\\b127\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}\\b",
      "flags": 0,
      "action": "block"
    },
    {
      "id": "localhost-port",
      "pattern": "\\blocalhost:\\d{1,256}\\b",
      "flags": 2,
      "action": "block"
    },
    {
      "id": "localhost-bare",
      "pattern": "(?<![\\w.-])localhost(?![\\w.-])",
      "flags": 2,
      "action": "block"
    },
    {
      "id": "port-reference",
      "pattern": "\\bport\\s{1,256}\\d{4,5}\\b",
      "flags": 2,
      "action": "block"
    },
    {
      "id": "windows-home-path",
      "pattern": "(?<![\\w.-])(?:(?<=(?P<windows_quote>[\\\"'`]))|(?<![\\\"'`]))[A-Z]:(?:\\\\{1,2}|/)Users(?:\\\\{1,2}|/)(?(windows_quote)[A-Za-z0-9._-](?:(?!(?P=windows_quote))[^\\r\\n<>:|?*])*?(?=(?P=windows_quote))|(?:[A-Za-z0-9._@+-]+(?: +[A-Za-z0-9._@+-]+)*(?:\\\\{1,2}|/))*(?:[A-Za-z0-9_@+-]+(?:[ .]+[A-Za-z0-9_@+-]+)*?\\.[A-Za-z0-9]+(?![\\w-]|\\.[\\w-])|[A-Za-z0-9._@+-]+))",
      "flags": 2,
      "action": "warn"
    },
    {
      "id": "home-path",
      "pattern": "(?<![\\w.-])/(?:home|Users)/(?!\\.(?:agents|cache|claude|codebuddy|codex|commandcode|config|copilot|cursor|factory|gemini|grok|kimi|local|localcode|pi|tabby)(?:/|$|[^A-Za-z0-9._-]))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._@+-]+)*",
      "flags": 0,
      "action": "warn"
    },
    {
      "id": "root-path",
      "pattern": "(?<![\\w.-])(?:(?<=(?P<root_quote>[\\\"'`]))/root(?:/[A-Za-z0-9._@+ -]+)+(?=(?P=root_quote))|/root(?:/[A-Za-z0-9._@+-]+)+)",
      "flags": 0,
      "action": "block"
    },
    {
      "id": "email",
      "pattern": "\\b[A-Z0-9._%+-]{1,256}@[A-Z0-9.-]{1,256}\\.[A-Z]{2,63}\\b(?!:\\S)",
      "flags": 2,
      "action": "warn"
    },
    {
      "id": "us-phone",
      "pattern": "(?:(?<!\\w)\\+1[\\s.-]?\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}(?!\\w)|(?<!\\w)\\(\\d{3}\\)\\s{0,256}\\d{3}[\\s.-]?\\d{4}(?!\\w)|(?<!\\w)\\d{3}[\\s.-]\\d{3}[\\s.-]\\d{4}(?!\\w)|\\b(?:phone|tel|call)[\\s:]{1,256}\\+?1?[\\s.-]?\\(?\\d{3}\\)?[\\s.-]?\\d{3}[\\s.-]?\\d{4}(?!\\w))",
      "flags": 2,
      "action": "warn"
    },
    {
      "id": "jwt-token",
      "pattern": "\\beyJ(?:[A-Za-z0-9_-]{4097}|[A-Za-z0-9_-]{8,4096}\\.(?:[A-Za-z0-9_-]{4097}|[A-Za-z0-9_-]{8,4096}\\.(?:[A-Za-z0-9_-]{4097}|[A-Za-z0-9_-]{8,4096}\\b)))",
      "flags": 0,
      "action": "block"
    },
    {
      "id": "bearer-token",
      "pattern": "\\bBearer\\s{1,256}(?:[A-Za-z0-9._~+/=-]{4097}|[A-Za-z0-9_~+/=-][A-Za-z0-9._~+/=-]{18,4094}[A-Za-z0-9_~+/=-](?![A-Za-z0-9_~+/=-]))",
      "flags": 2,
      "action": "block"
    },
    {
      "id": "api-key-assignment",
      "pattern": "\\b(?:api[_-]?key|token|secret)\\s{0,256}[:=]\\s{0,256}(?!(?:process\\.env|os\\.environ|os\\.getenv|config\\.|cfg\\.|settings\\.|env\\.|\\$\\{|\\$\\(|null\\b|None\\b|undefined\\b|''|\\\"\\\"))(?:['\\\"](?:[A-Za-z0-9._~+/=-]{4097}|[A-Za-z0-9._~+/=-]{20,4096}['\\\"])|(?!(?:[A-Za-z_$][A-Za-z0-9_$]*\\.)+[A-Za-z_$][A-Za-z0-9_$]*(?![A-Za-z0-9._~+/=-]))(?:[A-Za-z0-9._~+/=-]{4097}|(?=[A-Za-z._~+/=-]{0,4095}[0-9])[A-Za-z0-9_~+/=-](?:[A-Za-z0-9._~+/=-]{18,4094}[A-Za-z0-9_~+/=-])))",
      "flags": 2,
      "action": "block"
    },
    {
      "id": "bare-token-prefix",
      "pattern": "\\b(?:github_pat_(?:[A-Za-z0-9_]{8193}|[A-Za-z0-9_]{20,8192}\\b)|gh[pousr]_(?:[A-Za-z0-9]{8193}|[A-Za-z0-9]{20,8192}\\b)|xox[baprs]-(?:[A-Za-z0-9-]{8193}|[A-Za-z0-9-]{8,8192}\\b)|sk-(?:live|test|proj|ant)-(?:[A-Za-z0-9_-]{8193}|[A-Za-z0-9_-]{8,8192}\\b)|AKIA(?:[A-Z0-9]{8193}|[A-Z0-9]{16}\\b)|(?-i:ASIA(?:[A-Z0-9]{8193}|[A-Z0-9]{16}\\b))|(?-i:AIza(?:[A-Za-z0-9_-]{8193}|[A-Za-z0-9_-]{30,8192}(?![A-Za-z0-9_-]))|glpat-(?:[A-Za-z0-9_-]{8193}|[A-Za-z0-9_-]{16,8192}(?![A-Za-z0-9_-]))))",
      "flags": 2,
      "action": "block"
    },
    {
      "id": "private-key-block",
      "pattern": "-----BEGIN [A-Z ]{0,64}PRIVATE KEY-----",
      "flags": 0,
      "action": "block"
    },
    {
      "id": "private-hostname",
      "pattern": "(?<![\\w.-])(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?:local|internal|lan|corp|home|intranet|localdomain)(?![\\w-]|\\.[\\w-]|\\()",
      "flags": 2,
      "action": "block"
    }
  ]
}
