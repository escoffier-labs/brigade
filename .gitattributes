# Root Unreleased appends from sibling PRs should combine, not conflict.
# Built-in git merge driver; no extra gitconfig needed. See #994.
# Slash-anchored so nested CHANGELOG.md files stay unspecified.
/CHANGELOG.md merge=union

# Golden journal bytes use canonical LF framing on every platform.
/tests/fixtures/run-lifecycle/golden-lifecycle.jsonl text eol=lf

# The memory scan ruleset is identified by the SHA-256 of its bytes, so no checkout may rewrite its line endings.
/src/brigade/guard/memory-rules.json -text
