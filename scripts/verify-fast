#!/bin/bash
# Compatibility entrypoint for the same bounded, optional local full gate.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ "${JOBS+x}" = x ]; then
  if [[ ! "$JOBS" =~ ^[0-9]+$ ]] || [[ ! "$JOBS" =~ [1-9] ]]; then
    echo "verify-fast: JOBS must be a positive integer; unset JOBS for bounded defaults or set BRIGADE_VERIFY_SHARDS" >&2
    exit 2
  fi
  if [ "${BRIGADE_VERIFY_SHARDS+x}" = x ] && [ "$BRIGADE_VERIFY_SHARDS" != "$JOBS" ]; then
    echo "verify-fast: JOBS conflicts with BRIGADE_VERIFY_SHARDS; unset JOBS and use BRIGADE_VERIFY_SHARDS" >&2
    exit 2
  fi
  echo "verify-fast: JOBS is deprecated; use BRIGADE_VERIFY_SHARDS=$JOBS" >&2
  export BRIGADE_VERIFY_SHARDS="$JOBS"
fi

exec ./scripts/verify "$@"
