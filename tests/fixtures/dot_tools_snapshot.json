        "required": [
          "query"
        ],
        "title": "memory_searchArguments",
        "type": "object"
      },
      "name": "memory_search"
    },
    "message_send": {
      "annotations": {
        "readOnlyHint": false
      },
      "description": "Send a hub message to an allowed recipient. Requires dispatch_enabled. Identical sends deduplicate within a 10-minute UTC bucket. Pass a distinct client_id for each intentional repeat, and reuse it for retries.",
      "inputSchema": {
        "properties": {
          "body": {
            "title": "Body",
            "type": "string"
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Client Id"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Kind"
          },
          "priority": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Priority"
          },
          "ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ref"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "thread": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Thread"
          },
          "to": {
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ],
        "title": "message_sendArguments",
        "type": "object"
      },
      "name": "message_send"
    },
    "message_status": {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Read acknowledgement status for up to 50 hub messages sent by the dot.",
