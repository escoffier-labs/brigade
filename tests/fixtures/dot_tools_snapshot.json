    },
    "memory_search": {
      "annotations": {
        "readOnlyHint": true
      },
      "description": "Keyword-search canonical OpenClaw memory cards on the control host (brigade memory search). Returns card titles, tags and paths; read one with memory_card.",
      "inputSchema": {
        "properties": {
          "limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Limit"
          },
          "query": {
            "title": "Query",
