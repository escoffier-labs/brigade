{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.escoffier-labs/brigade-memory",
  "title": "Brigade Memory",
  "description": "Brigade memory: search and read cards across repo and user stores, and write Memory Handoffs.",
  "version": "0.31.0",
  "websiteUrl": "https://brigade.tools",
  "repository": {
    "url": "https://github.com/escoffier-labs/brigade",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "brigade-cli",
      "version": "0.31.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "memory"
        },
        {
          "type": "positional",
          "value": "serve-mcp"
        },
        {
          "type": "positional",
          "value": "--stdio"
        },
        {
          "type": "named",
          "name": "--target",
          "description": "Repo or workspace whose memory cards to serve.",
          "format": "filepath",
          "default": ".",
          "isRequired": false
        }
      ]
    }
  ]
}
