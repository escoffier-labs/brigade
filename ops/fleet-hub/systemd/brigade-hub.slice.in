# Hub, holder, front and backup containers (compose cgroup_parent). Needs
# Docker's systemd cgroup driver. Check the effective set with
# checks/s31_checks.py cgroups: a set the parent cannot meet falls back to the
# parent's set without an error.
[Unit]
Description=Brigade dogfood hub containers

[Slice]
AllowedCPUs=@HUB_CPUS@
CPUWeight=10000
MemoryMin=1G
MemoryMax=3G
IOWeight=1000
# Its peer here is the embedder slice only: this target keeps the embedder's
# model reads from stretching the hub's commits. The target on brigade.slice
# is the one that acts on agent writers.
IODeviceLatencyTargetSec=@DB_DEVICE@ @IO_LATENCY@
